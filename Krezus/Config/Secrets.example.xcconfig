// Copier ce fichier en `Secrets.xcconfig` (non versionné) et renseigner les valeurs.
// On stocke la RÉFÉRENCE du projet Supabase (pas l'URL complète) car xcconfig
// interprète « // » comme un commentaire et tronquerait « https:// ».
// L'URL est reconstruite dans Config.swift : https://<ref>.supabase.co

SUPABASE_PROJECT_REF = your-project-ref
SUPABASE_ANON_KEY = your-anon-key-jwt

// ID client Google OAuth (Sign in with Google). Laisser vide pour désactiver.
GOOGLE_OAUTH_CLIENT_ID =

// Identifiant de l'équipe Apple Developer (Membership details → Team ID).
// Requis uniquement pour archiver et envoyer sur TestFlight.
KREZUS_TEAM_ID =
