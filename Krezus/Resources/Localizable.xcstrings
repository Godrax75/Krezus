    "coach.advice.balance": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne pèse une grande part de ton portefeuille : sa variation entraîne presque tout le reste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One holding carries a large share of your portfolio: its moves drag almost everything else along."
          }
        }
      }
    },
    "coach.advice.diversification": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton portefeuille repose sur peu de secteurs. La leçon « La diversification » explique pourquoi ça compte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your portfolio rests on few sectors. The lesson “Diversification” explains why that matters."
          }
        }
      }
    },
    "coach.advice.knowledge": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il te reste des leçons à découvrir dans l'Academy — chacune éclaire une décision que tu prendras tôt ou tard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You still have lessons to discover in the Academy — each one sheds light on a decision you will face sooner or later."
