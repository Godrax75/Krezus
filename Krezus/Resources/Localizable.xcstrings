    "archetype.balanced.summary": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cherches un compromis entre sécurité et croissance, sans excès dans un sens ou dans l'autre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You look for a middle ground between safety and growth, without going too far either way."
          }
        }
      }
    },
