    "help.group.legal": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentions légales"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legal"
          }
        }
      }
    },
    "help.legal.educational": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Krezus est une application pédagogique. Les performances passées ne préjugent pas des performances futures, et aucun contenu de l'app ne constitue un conseil en investissement personnalisé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Krezus is an educational app. Past performance does not predict future performance, and no content in the app constitutes personalised investment advice."
          }
        }
      }
    },
    "help.legal.oracle": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les analyses, scénarios et prédictions présentés dans l'Oracle sont fournis à titre informatif. Les données de prédiction proviennent de marchés publics et ne sont reliées à aucune plateforme de paris."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The analyses, scenarios and predictions shown in the Oracle are provided for information only. Prediction data comes from public markets and is not linked to any betting platform."
          }
        }
      }
    },
    "help.legal.quotes": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cours sont différés de 15 minutes et ne peuvent pas être redistribués. Les logos d'entreprises sont utilisés à titre d'identification des titres."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prices are delayed by 15 minutes and may not be redistributed. Company logos are used to identify securities."
          }
        }
      }
    },
    "help.report_issue": {
