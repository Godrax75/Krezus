    "archetype.builder.summary": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu construis par petites touches régulières. C'est le tempérament qui profite le plus des intérêts composés."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You build in small, regular steps. That is the temperament compound interest rewards most."
          }
        }
      }
    },
