        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Explorer"
          }
        }
      }
    },
    "archetype.explorer.summary": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es à l'aise avec le mouvement et tu aimes comprendre ce qui bouge. Ton risque, c'est de confondre activité et progrès."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are comfortable with movement and like to understand what is shifting. Your risk is mistaking activity for progress."
          }
        }
      }
    },
    "archetype.guardian.name": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Gardien"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Guardian"
          }
        }
      }
    },
    "archetype.guardian.summary": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu privilégies la sécurité avant le rendement. Les baisses te coûtent plus qu'elles ne t'attirent — c'est un tempérament, pas un défaut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You put safety before return. Drops cost you more than they tempt you — that is a temperament, not a flaw."
          }
        }
      }
    },
