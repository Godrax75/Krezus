{
  "expo": {
    "name": "Krezus",
    "slug": "krezus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "krezus",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.krezus.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Krezus utilise la caméra pour scanner les QR codes des coffrets cadeaux.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.krezus.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "krezus"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Krezus utilise la caméra pour scanner les QR codes des coffrets cadeaux."
        }
      ]
    ]
  }
}
